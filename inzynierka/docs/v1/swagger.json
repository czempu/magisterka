{
    "schemes": [
        "https",
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Documentation of WTRHUB API.",
        "title": "Work Time Registration HUB API",
        "contact": {
            "email": "contact@erpbadger.com"
        },
        "version": "1.0"
    },
    "host": "www.localhost:8080",
    "paths": {
        "/api/me/modules": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Zwraca moduły przypisane do aktualnie zalogowanego użytkownika.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Me"
                ],
                "summary": "Lista modułów użytkownika",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_interface_http_modules.ModulesResponse"
                        }
                    }
                }
            }
        },
        "/api/users": {
            "get": {
                "description": "Zwraca listę użytkowników względem poziomu uprawnień.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Users",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_interface_http_users.UsersResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_interface_http_users.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_interface_http_users.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/login/cookie": {
            "post": {
                "description": "Zwraca ciasteczko po poprawnej autoryzacji.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Login/cookie (issue JWT)",
                "parameters": [
                    {
                        "description": "Login payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/wtrhub_internal_interface_http_auth.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/wtrhub_internal_interface_http_auth.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/wtrhub_internal_interface_http_auth.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/login/token": {
            "post": {
                "description": "Zwraca token dostępu po poprawnej autoryzacji.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Login/token (issue JWT)",
                "parameters": [
                    {
                        "description": "Login payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/wtrhub_internal_interface_http_auth.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/wtrhub_internal_interface_http_auth.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/wtrhub_internal_interface_http_auth.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/wtrhub_internal_interface_http_auth.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "internal_interface_http_auth.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "invalid credentials"
                }
            }
        },
        "internal_interface_http_auth.LoginRequest": {
            "type": "object",
            "properties": {
                "pass": {
                    "type": "string"
                },
                "user": {
                    "type": "string"
                }
            }
        },
        "internal_interface_http_auth.LoginResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                },
                "expires_in": {
                    "type": "integer",
                    "example": 604800
                },
                "token_type": {
                    "type": "string",
                    "example": "Bearer"
                }
            }
        },
        "internal_interface_http_modules.Module": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "użytkownicy"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "module_name": {
                    "type": "string",
                    "example": "users"
                },
                "role": {
                    "type": "string",
                    "example": "test"
                }
            }
        },
        "internal_interface_http_modules.ModulesResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_interface_http_modules.Module"
                    }
                }
            }
        },
        "internal_interface_http_users.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "invalid credentials"
                }
            }
        },
        "internal_interface_http_users.UserItem": {
            "type": "object",
            "properties": {
                "Name": {
                    "type": "string",
                    "example": "Marcel"
                },
                "Surname": {
                    "type": "string",
                    "example": "Czempik"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "username": {
                    "type": "string",
                    "example": "czempu"
                }
            }
        },
        "internal_interface_http_users.UsersResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_interface_http_users.UserItem"
                    }
                }
            }
        },
        "wtrhub_internal_interface_http_auth.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "invalid credentials"
                }
            }
        },
        "wtrhub_internal_interface_http_auth.LoginRequest": {
            "type": "object",
            "properties": {
                "pass": {
                    "type": "string"
                },
                "user": {
                    "type": "string"
                }
            }
        },
        "wtrhub_internal_interface_http_auth.LoginResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                },
                "expires_in": {
                    "type": "integer",
                    "example": 604800
                },
                "token_type": {
                    "type": "string",
                    "example": "Bearer"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}