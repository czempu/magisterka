# Konfiguracja API Resend (wysyłka maili)
RESEND_API_KEY=your_resend_api_key_here

# Tajny klucz do podpisywania tokenów JWT (minimum 32 znaki)
APP_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# Główna baza danych RCP (MySQL 8.0)
# Format: user:password@tcp(host:port)/dbname?parseTime=true
DB_DSN=appuser:apppassword@tcp(127.0.0.1:3306)/RCP?allowNativePasswords=true

# Odizolowana baza danych Kanban (kalendarz)
KANBAN_DB_DSN=appuser:apppassword@tcp(127.0.0.1:3306)/kalendarz?allowNativePasswords=true
